{
  "expo": {
    "name": "Proof",
    "slug": "proof-progress-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "proof",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.proof.progresstracker",
      "icon": "./assets/images/icon.png",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.proof.progresstracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Proof needs access to your photos to capture visual evidence of your progress.",
          "cameraPermission": "Proof needs camera access to photograph your practice sessions."
        }
      ]
    ],
    "cli": {
      "appVersionSource": "remote"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b35d276-5741-4978-ad25-cd181b2a28c6"
      }
    },
    "owner": "sarthakraj23"
  }
}
