# Frontend Environment Configuration for Proof Mobile App
# IMPORTANT: Replace placeholder values with your actual credentials.
# For production deployment (Vercel), set these in Vercel Project Settings → Environment Variables.

# Backend API URL (FastAPI)
# Local: http://localhost:8000
# Production: https://proof-progress-tracker.onrender.com
EXPO_PUBLIC_API_URL=https://proof-progress-tracker.onrender.com

# Supabase Public Configuration (Safe to expose on client)
# Get these from Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# RevenueCat Public API Keys (Safe to expose on client)
# Get these from RevenueCat Dashboard → Project → API Keys
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_apple_api_key_here
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_google_api_key_here