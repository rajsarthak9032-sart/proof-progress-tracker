# Production Environment Variables for Proof Backend
# Copy these to your hosting provider's environment variable settings
# NEVER commit actual secrets to version control

# Application
APP_NAME="Proof API"
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Supabase Configuration (from Supabase Project Settings -> API)
# Required for database operations and authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-private
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Hugging Face Inference API (Server-side secret only - NEVER expose to frontend)
# Get token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_hugging_face_token_here
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_API_TIMEOUT_SECONDS=15.0

# RevenueCat Webhook Secret (from RevenueCat Dashboard -> Integrations -> Webhooks)
REVENUECAT_WEBHOOK_AUTH_HEADER=your_revenuecat_webhook_secret_header

# CORS - MUST match your Vercel frontend URL exactly
# Replace with your actual Vercel deployment URL
CORS_ORIGINS=["https://frontend-ten-delta-61.vercel.app"]

# Security - Generate a strong random secret for production
# openssl rand -hex 32
AUTH_SECRET=your-generated-32-char-minimum-secret-here