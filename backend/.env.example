# Environment Configuration for Proof Backend
APP_NAME="Proof API"
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-private
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Hugging Face Inference API (Server-side secret)
HF_TOKEN=hf_your_hugging_face_token_here
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_API_TIMEOUT_SECONDS=15.0

# RevenueCat Webhook Secret
REVENUECAT_WEBHOOK_AUTH_HEADER=your_revenuecat_webhook_secret_header

# CORS
CORS_ORIGINS=["*"]
